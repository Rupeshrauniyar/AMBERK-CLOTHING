# Root .gitignore for Amberk Clothing MERN project

# Dependencies
node_modules/
*/node_modules/
.pnp
.pnp.js

# Environment variables & secrets
.env
.env.*
*.local
!.env.example
!*/.env.example

# Production builds & artifacts
dist/
*/dist/
dist-ssr/
*/dist-ssr/
build/
*/build/
out/
.output/

# Cache directories
.cache/
.parcel-cache/
.turbo/
.eslintcache
.stylelintcache
*.tsbuildinfo
.vite/
*/.vite/

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# User uploads & media in backend
backend/uploads/*
!backend/uploads/.gitkeep
uploads/*
!uploads/.gitkeep

# Operating System files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
[Dd]esktop.ini
$RECYCLE.BIN/

# IDE and Editor files
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
*~
*.bak
*.tmp
*.temp

# Test and Coverage
coverage/
*/coverage/
.nyc_output/
cypress/screenshots/
cypress/videos/

